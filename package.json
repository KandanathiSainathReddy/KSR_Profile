{
  "name": "ksr-profile",
  "version": "0.1.0",
  "private": true,
  "description": "Personal work page — Amplify Gen 2 (same shape as agent-maker-checker)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/site run dev",
    "build:site": "npm --workspace apps/site run build",
    "ampx:sandbox": "ampx sandbox",
    "ampx:deploy": "ampx pipeline-deploy",
    "typecheck": "tsc -p amplify/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@types/node": "^22.10.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0"
  }
}
